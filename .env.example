# Aihylu — environment template.
# Copy to .env and fill in. Never commit the filled file.

# ─── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional: cheap vision/judging passes in media pipelines
OPENROUTER_API_KEY=

# ─── Messaging channel ────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# ─── Voice ────────────────────────────────────────────────────────────────────
# faster-whisper model name: tiny | base | small | medium | large-v3
WHISPER_MODEL=base
# Text-to-speech (optional, for spoken replies / narration)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ─── Media & publishing pipelines (optional) ──────────────────────────────────
YOUTUBE_CLIENT_SECRET_PATH=
YOUTUBE_TOKEN_PATH=
REPLICATE_API_TOKEN=
STOCK_FOOTAGE_API_KEY=

# ─── Object storage (optional, for hosting generated assets) ──────────────────
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_BUCKET=

# ─── Deploy target (optional) ─────────────────────────────────────────────────
DEPLOY_HOST=YOUR_VPS_IP
DEPLOY_USER=deploy
DEPLOY_SSH_KEY=~/.ssh/id_ed25519
